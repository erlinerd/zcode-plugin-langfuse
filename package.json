{
  "name": "zcode-plugin-langfuse",
  "version": "0.3.0",
  "private": true,
  "description": "A fail-open Langfuse observability plugin for ZCode.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "clean": "node scripts/clean.mjs",
    "test": "vitest run",
    "lint": "oxlint src test scripts",
    "lint:fix": "oxlint --fix src test scripts",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate.mjs",
    "validate:artifact": "node scripts/validate.mjs --artifact",
    "sync:catalog": "node scripts/sync-catalog.mjs",
    "package:plugin": "npm run build && npm run validate && npm run validate:artifact",
    "check": "npm run lint && npm run typecheck && npm test && npm run validate",
    "prepare": "husky && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxlint": "^1.82.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@langfuse/otel": "^5.11.1",
    "@langfuse/tracing": "^5.11.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0"
  }
}
